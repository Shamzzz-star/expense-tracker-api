# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required unless DJANGO_DEBUG=True.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Debug is off unless set here. Keep it True only for local development.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: move the admin site away from /admin/
# DJANGO_ADMIN_URL=admin/
# Optional: login/sign-up attempts allowed per IP
# DJANGO_AUTH_RATE=10/min

# Only when serving over HTTPS (turns on secure cookies, HSTS and http->https redirect)
# DJANGO_HTTPS=True
# DJANGO_BEHIND_PROXY=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Leave POSTGRES_DB empty to use SQLite locally.
# POSTGRES_DB=expenses
# POSTGRES_USER=expenses
# POSTGRES_PASSWORD=expenses
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
